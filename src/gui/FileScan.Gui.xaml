<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileScan | Windows integrity" Width="1120" Height="850" MinWidth="980" MinHeight="750"
        WindowStartupLocation="CenterScreen" Background="#F4F3EF" FontFamily="Segoe UI" FontSize="13" Foreground="#292C27"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="9,7"/><Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C9CCC3"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="MinHeight" Value="34"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="13,8"/><Setter Property="Background" Value="#F4F3EF"/>
      <Setter Property="BorderBrush" Value="#B8BDB2"/><Setter Property="Foreground" Value="#292C27"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="36"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.6"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#AB421B"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.35"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,12,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Margin" Value="0,11,0,5"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#676E61"/></Style>
    <Style x:Key="Operation" TargetType="RadioButton">
      <Setter Property="Padding" Value="18,11"/><Setter Property="Foreground" Value="#4C5347"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Face" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#F1E7DB"/><Setter TargetName="Face" Property="BorderBrush" Value="#AB421B"/><Setter Property="Foreground" Value="#873411"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#E9E8E1"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#AB421B"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#676E61"/><Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="Underline" BorderBrush="Transparent" BorderThickness="0,0,0,2" Margin="0,0,24,0" Padding="0,9,0,12">
          <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" TextElement.FontWeight="SemiBold"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Underline" Property="BorderBrush" Value="#AB421B"/><Setter Property="Foreground" Value="#292C27"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#AB421B"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Underline" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
        <Grid KeyboardNavigation.TabNavigation="Local">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border BorderBrush="#CDD0C6" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/></Border>
          <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0,16,0,0"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Padding" Value="10,9"/><Setter Property="Background" Value="#EAECE5"/>
      <Setter Property="Foreground" Value="#59614F"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="#CCD0C4"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="8,5"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#F1E1CC"/><Setter Property="Foreground" Value="#292C27"/></Trigger></Style.Triggers>
    </Style>
  </Window.Resources>
  <Grid x:Name="Root" Background="#F4F3EF">
    <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#252A23" BorderBrush="#AB421B" BorderThickness="0,0,0,3" Padding="24,0">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="AdminLabel" Text="Standard access" Foreground="#C3CABD" FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"/>
          <Button x:Name="LoadReportButton" Content="Load report..." Background="#353C30" Foreground="#F4F3EF" BorderBrush="#626C57"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border BorderBrush="#E3A77C" BorderThickness="1" Width="35" Height="32" Margin="0,0,12,0">
            <Path Data="M 0,10 L 5,10 L 8,0 L 12,20 L 16,10 L 23,10" Stroke="#E3A77C" StrokeThickness="1.5" Stretch="Uniform" Width="23" Height="20"/>
          </Border>
          <TextBlock Text="FILESCAN" Foreground="#F7F4EB" FontFamily="Bahnschrift" FontSize="23" VerticalAlignment="Center"/>
          <Border BorderBrush="#626C57" BorderThickness="1,0,0,0" Margin="18,6,0,6" Padding="18,0,0,0">
            <TextBlock Text="WINDOWS INTEGRITY" Foreground="#C3CABD" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" BorderBrush="#CDD0C6" BorderThickness="0,0,0,1" Padding="24,0" Background="#EAECE5">
      <DockPanel>
        <TextBlock Text="Check / Repair requires Administrator access" DockPanel.Dock="Right" Foreground="#676E61" FontSize="11" VerticalAlignment="Center" Margin="18,0,0,0"/>
        <TextBlock Text="OPERATION" DockPanel.Dock="Left" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,24,0"/>
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="AnalyzeMode" GroupName="Mode" IsChecked="True" Content="_Analyze logs" Style="{StaticResource Operation}" ToolTip="Read existing CBS and DISM logs."/>
          <RadioButton x:Name="CheckMode" GroupName="Mode" Content="_Check system" Style="{StaticResource Operation}" ToolTip="Scan the component store and verify protected system files."/>
          <RadioButton x:Name="RepairMode" GroupName="Mode" Content="_Repair system" Style="{StaticResource Operation}" ToolTip="Repair the component store and protected system files."/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="2" Margin="24,18,24,0">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,12">
        <TextBlock x:Name="Heading" Text="Log inspection" FontFamily="Bahnschrift" FontSize="24"/>
        <TextBlock x:Name="Description" Text="Read servicing events and inspect the results." Foreground="#676E61" Margin="0,5,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <TabControl x:Name="Tabs" Grid.Row="1">
        <TabItem Header="Inputs" x:Name="SetupTab">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,8">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="LOG FILES &amp; OUTPUT" Style="{StaticResource SectionLabel}"/>
                  <TextBlock Text="Read Windows logs or choose copies from another computer." Foreground="#676E61" TextWrapping="Wrap" Margin="0,6,0,5"/>
                  <TextBlock Text="Component servicing / CBS" Style="{StaticResource FieldLabel}"/>
                  <DockPanel><Button x:Name="CbsBrowse" Content="Browse..." DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="CbsPath" FontFamily="Consolas" FontSize="12"/></DockPanel>
                  <TextBlock Text="Deployment servicing / DISM" Style="{StaticResource FieldLabel}"/>
                  <DockPanel><Button x:Name="DismBrowse" Content="Browse..." DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="DismPath" FontFamily="Consolas" FontSize="12"/></DockPanel>
                  <TextBlock Text="Report directory" Style="{StaticResource FieldLabel}"/>
                  <DockPanel><Button x:Name="OutputBrowse" Content="Browse..." DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="OutputDirectory" FontFamily="Consolas" FontSize="12"/></DockPanel>
                  <TextBlock Text="Each run saves a separate text, JSON, and HTML report." Foreground="#676E61" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" BorderBrush="#CDD0C6" BorderThickness="1,0,0,0" Padding="24,0,0,0">
                  <StackPanel>
                    <TextBlock Text="ANALYSIS WINDOW" Style="{StaticResource SectionLabel}"/>
                    <CheckBox x:Name="CustomRange" Content="Set a date or time range" Margin="0,12,0,10"/>
                    <Grid x:Name="DateFields"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Text="From (included)" Margin="0,0,0,5"/><TextBox x:Name="Since" FontFamily="Consolas" FontSize="12"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Until" Margin="0,0,0,5"/><TextBox x:Name="Until" FontFamily="Consolas" FontSize="12"/></StackPanel>
                    </Grid>
                    <TextBlock x:Name="DateHint" Text="Default: today." Foreground="#676E61" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,14"/>
                    <CheckBox x:Name="IncludeHistory" Content="Include rotated logs"/>
                    <CheckBox x:Name="IncludeInfo" Content="Include routine Info entries"/>
                    <DockPanel Margin="0,10,0,8"><TextBox x:Name="MaxEntries" Width="78" DockPanel.Dock="Right" FontFamily="Consolas"/><TextBlock Text="Retain newest entries" VerticalAlignment="Center"/></DockPanel>
                    <CheckBox x:Name="FailOnFindings" Content="Flag errors and warnings in the result"/>
                  </StackPanel>
                </Border>
              </Grid>
              <Expander x:Name="RepairOptions" Header="Repair source" Margin="0,24,0,0" BorderBrush="#CDD0C6" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <StackPanel Margin="0,12,0,0">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Source type" Margin="0,0,0,5"/><ComboBox x:Name="SourceType"><ComboBoxItem Content="Default"/><ComboBoxItem Content="Folder"/><ComboBoxItem Content="WIM"/><ComboBoxItem Content="ESD"/></ComboBox></StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="Source path" Margin="0,0,0,5"/><DockPanel><Button x:Name="SourceBrowse" Content="Browse..." DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="SourcePath" FontFamily="Consolas" FontSize="12"/></DockPanel></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Image index" Margin="0,0,0,5"/><TextBox x:Name="ImageIndex" FontFamily="Consolas" ToolTip="Index of the matching Windows edition inside the WIM or ESD image."/></StackPanel>
                  </Grid>
                  <CheckBox x:Name="LimitAccess" Content="Use local repair content only (do not contact Windows Update)" Margin="0,12,0,0"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Findings" x:Name="ResultsTab">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border BorderBrush="#CDD0C6" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <StackPanel Width="165"><TextBlock Text="MATCHING ENTRIES" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="MatchCount" Text="--" FontFamily="Consolas" FontSize="26" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Width="145"><TextBlock Text="ERRORS" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="ErrorCount" Text="--" FontFamily="Consolas" FontSize="26" Foreground="#A53A26" Margin="0,3,0,0"/></StackPanel>
                <StackPanel Width="145"><TextBlock Text="WARNINGS" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="WarningCount" Text="--" FontFamily="Consolas" FontSize="26" Foreground="#8A5C13" Margin="0,3,0,0"/></StackPanel>
                <StackPanel><TextBlock Text="UNREPAIRABLE EVENTS" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="UnrepairableCount" Text="--" FontFamily="Consolas" FontSize="26" Margin="0,3,0,0"/></StackPanel>
              </StackPanel>
            </Border>
            <DockPanel Grid.Row="1" Margin="0,0,0,12">
              <ComboBox x:Name="SeverityFilter" Width="155" DockPanel.Dock="Right" Margin="12,0,0,0" SelectedIndex="0"><ComboBoxItem Content="All entries"/><ComboBoxItem Content="Errors"/><ComboBoxItem Content="Warnings"/><ComboBoxItem Content="SFC events"/></ComboBox>
              <Grid><TextBox x:Name="Search" ToolTip="Search messages, interpretations, and source paths"/>
                <TextBlock Text="Search messages, interpretations, or source paths" Foreground="#767E6D" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </DockPanel>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
              <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" RowHeight="32"
                        EnableRowVirtualization="True" EnableColumnVirtualization="False" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                        HorizontalGridLinesBrush="#E6E9DF" HeadersVisibility="Column" BorderBrush="#CDD0C6" Background="White" RowBackground="White" AlternatingRowBackground="#F8F9F5">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="TIME" Binding="{Binding DisplayTime}" Width="170"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="12"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
                  <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="68"/>
                  <DataGridTemplateColumn Header="LEVEL" Width="80" SortMemberPath="Severity"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <TextBlock Text="{Binding Severity}" FontSize="12"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#676E61"/><Style.Triggers>
                      <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter Property="Foreground" Value="#A53A26"/><Setter Property="FontWeight" Value="SemiBold"/></DataTrigger>
                      <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="#8A5C13"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style></TextBlock>
                  </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="MESSAGE" Binding="{Binding Message}" Width="*" MinWidth="180"/>
                </DataGrid.Columns>
              </DataGrid>
              <Border Grid.Column="2" Background="#EAECE5" BorderBrush="#AB421B" BorderThickness="0,3,0,0" Padding="14">
                <DockPanel>
                  <Button x:Name="CopyButton" Content="Copy selected entry" DockPanel.Dock="Bottom" IsEnabled="False" Margin="0,12,0,0"/>
                  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10"><TextBlock Text="ENTRY INSPECTOR" Style="{StaticResource SectionLabel}"/><TextBlock Text="Full text &amp; source location" Foreground="#676E61" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                  <TextBox x:Name="EntryDetails" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                           Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Top" Text="Select a log entry to inspect its full text and location."/>
                </DockPanel>
              </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="ResultsHint" Text="Run analysis or load a saved JSON report." TextWrapping="Wrap" Foreground="#676E61" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="OpenHtmlButton" Content="HTML report" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="OpenFolderButton" Content="Report folder" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="Export ZIP..." IsEnabled="False"/></StackPanel>
            </Grid>
          </Grid>
        </TabItem>
        <TabItem Header="Transcript" x:Name="ActivityTab">
          <Border Background="#252A23" Padding="16" BorderBrush="#AB421B" BorderThickness="0,3,0,0"><DockPanel>
            <TextBlock Text="COMMAND TRANSCRIPT" DockPanel.Dock="Top" Foreground="#E3A77C" FontFamily="Consolas" FontSize="11" Margin="0,0,0,12"/>
            <TextBox x:Name="Activity" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                     Background="Transparent" Foreground="#DEE3D5" BorderThickness="0" Padding="0" VerticalContentAlignment="Top" Text="Ready. Preview a plan or start an operation."/>
          </DockPanel></Border>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="3" BorderBrush="#CDD0C6" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="24,12,24,14" Background="#EAECE5">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel><TextBlock x:Name="Elapsed" Text="" DockPanel.Dock="Right" Foreground="#676E61" FontFamily="Consolas"/><TextBlock x:Name="Status" Text="Ready for log inspection" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
        <ProgressBar x:Name="Progress" Grid.Row="1" Height="3" Margin="0,8,0,12" Minimum="0" Maximum="1" Value="0" Foreground="#AB421B" Background="#D3D8CA" BorderThickness="0"/>
        <DockPanel Grid.Row="2"><Button x:Name="RunButton" Content="Analyze logs" DockPanel.Dock="Right" Background="#AB421B" Foreground="#FFFFFF" BorderBrush="#AB421B" MinWidth="152"/>
          <StackPanel Orientation="Horizontal"><Button x:Name="PreviewButton" Content="Preview plan" Margin="0,0,10,0"/><Button x:Name="StopButton" Content="Stop after current command" IsEnabled="False"/></StackPanel>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
